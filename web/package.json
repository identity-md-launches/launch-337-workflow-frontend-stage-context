{
  "name": "happy-hour-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview",
    "validate:export": "node scripts/export.mjs --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx scripts/browser-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
